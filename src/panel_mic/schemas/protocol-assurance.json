{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_n",
    "control_n",
    "future_n",
    "possible_tail_reference",
    "possible_tail_control"
  ],
  "properties": {
    "reference_n": {
      "$ref": "#/$defs/count"
    },
    "control_n": {
      "$ref": "#/$defs/count"
    },
    "future_n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "possible_tail_reference": {
      "$ref": "#/$defs/tail"
    },
    "possible_tail_control": {
      "$ref": "#/$defs/tail"
    },
    "independent_stages": {
      "type": "boolean"
    },
    "percentile": {
      "enum": [
        0.99,
        0.999
      ]
    },
    "target_power": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "alpha": {
      "$ref": "#/$defs/error"
    },
    "reference_error": {
      "$ref": "#/$defs/error"
    },
    "control_error": {
      "$ref": "#/$defs/error"
    },
    "threshold_family_size": {
      "$ref": "#/$defs/count"
    },
    "future_ambiguous_budget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ambiguity_tail_caps": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {
            "$ref": "#/$defs/count"
          },
          {
            "$ref": "#/$defs/tail"
          }
        ],
        "items": false
      }
    },
    "unmodelled_share": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 1
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "tail": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "error": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 0.5
    }
  },
  "title": "Panel-MIC protocol-assurance input",
  "description": "Fixed hypothetical observation-law inputs; QC calibration uncertainty is separate. Runtime validates mutually exclusive ambiguity contracts."
}
